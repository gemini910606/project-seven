{
  "name": "gta7-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Workers backend: accounts, runs, leaderboards, remote config and lobbies.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply gta7-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gta7-db --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "3.99.0"
  }
}
